fastlane_version "2.220.0"
require "dotenv"

Dotenv.load("../project.env")
Dotenv.load

default_platform(:ios)

def project_root
  File.expand_path("../..", __dir__)
end

def project_path
  ENV["XCODE_PROJ_PATH"].to_s.strip.empty? ? File.join(project_root, "#{required_env('PROJECT_NAME')}.xcodeproj") : ENV["XCODE_PROJ_PATH"]
end

def project_spec_path
  File.join(project_root, "Scripts", "xcodegen", "Application.yml")
end

def required_env(key)
  value = ENV[key].to_s.strip
  UI.user_error!("Missing required environment variable #{key}") if value.empty?

  value
end

def update_project_setting!(key, value)
  path = project_spec_path
  content = File.read(path)
  found = false
  updated = content.sub(/^(\s*)#{Regexp.escape(key)}:\s*.+$/) do
    found = true
    "#{$1}#{key}: #{value}"
  end
  UI.user_error!("Could not find #{key} in #{path}") unless found

  File.write(path, updated)
end

def current_marketing_version
  match = File.read(project_spec_path).match(/^\s*MARKETING_VERSION:\s*(.+)$/)
  UI.user_error!("Could not find MARKETING_VERSION in #{project_spec_path}") unless match

  match[1].strip.delete('"')
end

def next_patch_version(version)
  parts = version.split(".").map(&:to_i)
  UI.user_error!("Unsupported MARKETING_VERSION format: #{version}") unless parts.length == 3

  parts[2] += 1
  parts.join(".")
end

def update_project_versioning!(marketing_version:, build_number:)
  update_project_setting!("MARKETING_VERSION", "\"#{marketing_version}\"")
  update_project_setting!("CURRENT_PROJECT_VERSION", build_number)
end

def app_store_connect_api_key_options
  {
    key_id: required_env("APP_STORE_CONNECT_API_KEY_ID"),
    issuer_id: required_env("APP_STORE_CONNECT_API_ISSUER_ID"),
    key_content: required_env("APP_STORE_CONNECT_API_KEY_CONTENT"),
    in_house: false,
    is_key_content_base64: true
  }
end

def current_branch
  ENV["GITHUB_REF_NAME"] || git_branch
end

def ensure_deploy_branch!
  branch = current_branch
  allowed_branches = (ENV["DEPLOY_ALLOWED_BRANCHES"] || "master,main").split(",").map(&:strip)
  return if allowed_branches.include?(branch)

  UI.user_error!("Deploy is allowed only from #{allowed_branches.join(', ')}. Current branch: #{branch}")
end

platform :ios do
  desc "Deploy Fight Clock to TestFlight"
  lane :deploy_to_tf do |options|
    ensure_deploy_branch!

    app_identifier = required_env("BUNDLE_ID")
    extension_identifier = "#{app_identifier}.liveactivity"
    team_id = required_env("TEAM_ID")
    scheme_name = required_env("TARGET_NAME")
    keychain_password = required_env("CI_KEYCHAIN_PASSWORD")
    keychain_name = "fight_clock_ci_#{ENV.fetch('GITHUB_RUN_ID', Process.pid)}_#{ENV.fetch('GITHUB_RUN_ATTEMPT', 1)}"
    keychain_path = File.expand_path("~/Library/Keychains/#{keychain_name}-db")
    api_key = app_store_connect_api_key(app_store_connect_api_key_options)

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 0,
      lock_when_sleeps: false,
      add_to_search_list: true
    )
    match(
      api_key: api_key,
      app_identifier: [
        app_identifier,
        extension_identifier
      ],
      readonly: true,
      keychain_name: keychain_name,
      keychain_password: keychain_password
    )
    sh(
      "security unlock-keychain -p #{keychain_password.shellescape} #{keychain_path.shellescape}",
      log: false
    )
    sh(
      "security set-keychain-settings -lut 21600 #{keychain_path.shellescape}",
      log: false
    )
    sh(
      "security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k #{keychain_password.shellescape} #{keychain_path.shellescape}",
      log: false
    )
    identities = sh(
      "security find-identity -v -p codesigning #{keychain_path.shellescape}",
      log: false
    )
    UI.user_error!("No valid code-signing identity was imported into #{keychain_name}") if identities.include?("0 valid identities found")

    marketing_version = current_marketing_version
    latest_build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: app_identifier,
      version: marketing_version,
      initial_build_number: 1
    )
    build_number = latest_build_number + 1

    if options[:bump_version].to_s == "true"
      marketing_version = next_patch_version(marketing_version)
    end

    update_project_versioning!(
      marketing_version: marketing_version,
      build_number: build_number
    )

    sh("../generate.sh")

    update_code_signing_settings(
      use_automatic_signing: false,
      path: project_path,
      team_id: team_id,
      targets: ["BoxingTimer"],
      profile_name: "match AppStore #{app_identifier}",
      code_sign_identity: "Apple Distribution"
    )
    update_code_signing_settings(
      use_automatic_signing: false,
      path: project_path,
      team_id: team_id,
      targets: ["BoxingTimerLiveActivity"],
      profile_name: "match AppStore #{extension_identifier}",
      code_sign_identity: "Apple Distribution"
    )

    gym(
      project: project_path,
      configuration: "Release",
      scheme: scheme_name,
      silent: false,
      clean: true,
      export_method: "app-store",
      export_team_id: team_id,
      include_symbols: true,
      xcargs: "DEVELOPMENT_TEAM=#{team_id}",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          app_identifier => "match AppStore #{app_identifier}",
          extension_identifier => "match AppStore #{extension_identifier}"
        }
      }
    )
    upload_to_testflight(
      api_key: api_key
    )
    version_paths = [project_spec_path]
    git_add(path: version_paths)
    git_commit(
      path: version_paths,
      message: "Bump version and build number [skip ci]",
      allow_nothing_to_commit: true
    )
    push_to_git_remote(
      local_branch: current_branch,
      remote_branch: current_branch
    )
  end
end
